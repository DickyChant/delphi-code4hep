# Known-compatible integration set. Keep refs for human navigation and commits
# for reproducibility.
CODE4HEP_URL=https://github.com/DickyChant/code4hep-Code4hep.git
CODE4HEP_REF=integrate/delphi-converter
CODE4HEP_COMMIT=1e716e20dff2a237b0863626c438d09da870504c

DELPHI_EDM4HEP_URL=https://github.com/DickyChant/delphi-edm4hep.git
DELPHI_EDM4HEP_REF=feature/code4hep-no-skelana
DELPHI_EDM4HEP_COMMIT=e52a90564f1fbfd5b0ed0066c7bcd320632c536f

CODE4HEP_BUILD_URL=https://github.com/DickyChant/code4hep-build.git
CODE4HEP_BUILD_REF=integrate/delphi-source
CODE4HEP_BUILD_COMMIT=649328dcf52beb0516567383ae6ac37313ec7edc

KEY4HEP_TEST_RELEASE=2026-04-08
DELPHI_RELEASE_ROOT=/cvmfs/delphi.cern.ch/releases/almalinux-9-x86_64/v24072026-1

# Framework dependencies not shipped as first-class packages by the Key4hep
# stack used above.  Both revisions are immutable and verified after checkout.
STITCHED_URL=https://github.com/code4hep/stitched-alpha2.git
STITCHED_REF=stitched-2026-08-21
STITCHED_COMMIT=3e196df974f74ff4b1bc3b54e8319bdb0a258f5b

C4H_MD5_URL=https://github.com/Dr15Jones/c4h_md5.git
C4H_MD5_REF=main
C4H_MD5_COMMIT=56babaebae83437829f8262b7eb8c4a59db9f864

# Stitched currently needs these two CMSSW externals.  Pin their CVMFS builds
# as part of the integration set rather than selecting an arbitrary glob.
STITCHED_TINYXML2_ROOT=/cvmfs/cms.cern.ch/el9_amd64_gcc13/external/tinyxml2/6.2.0-67924ead96ecb4e69aad321b767979a5
STITCHED_CPU_FEATURES_ROOT=/cvmfs/cms.cern.ch/el9_amd64_gcc13/external/cpu_features/0.9.0-9345f64300a0e12ee5bd1420a0e15254
STITCHED_BOOST_ROOT=/cvmfs/sw.hsf.org/key4hep/releases/2026-02-01/x86_64-almalinux9-gcc14.2.0-opt/boost/1.89.0-h55oha
